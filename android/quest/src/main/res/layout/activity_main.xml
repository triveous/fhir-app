<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.main.AppMainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation"
        app:navGraph="@navigation/application_nav_graph"
        app:defaultNavHost="true" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/bottom_nav_background"
        app:elevation="0dp"
        app:menu="@menu/bottom_nav_menu" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/sync_progress_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_navigation" />

    <!-- Hosts the soft/forced app-update prompt. The prompt is a Compose Dialog rendered in its own
         window, so this host stays 0x0 (wrap_content, empty) while idle and never intercepts touches
         to the content or bottom navigation beneath it. A forced prompt is a non-dismissible modal
         that blocks the app behind it. -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/app_update_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</RelativeLayout>
